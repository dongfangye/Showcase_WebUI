/* ============================================================================
 * setting.json —— 设置面板配置文件
 * ----------------------------------------------------------------------------
 * 本文件支持注释（// 行注释 与 块注释），也允许结尾多余的逗号，
 * 方便随时增删、临时禁用某个配置项。
 *
 * 整体结构：
 *   {
 *     "tabs": {
 *       "<Tab的id>": {                     // key 即 Tab 显示名，同时作为内部 id
 *         "<字段名>": { ...字段配置... },   // 每个 key 对应面板上一个设置项
 *         ...
 *       },
 *       "<另一个Tab的id>": { ... }
 *     }
 *   }
 *
 * 字段配置项（只有 default 是必填的，其余都可省略）：
 *   ch_Name      string    面板上显示的标签文字；不写则显示字段名
 *   default      any       默认值；同时也是"类型自动推断"的依据
 *   type         string    控件类型，见下方"控件类型"；不写则按 default 推断
 *   value        any       实际初始值（与 default 分开使用）；不写则用 default
 *   options      array     下拉框候选项，见下方"下拉框 options 写法"
 *   min/max/step number    仅 number / range 有效：最小值、最大值、步长
 *   placeholder  string    仅 text / number / textarea 有效：占位提示文字
 *
 * ----------------------------------------------------------------------------
 * 一、控件类型（type）一览
 * ----------------------------------------------------------------------------
 *   "text"        单行输入框          { "default": "default" }
 *   "number"      数字输入框          { "type": "number", "default": 3, "min": 1, "max": 8, "step": 1 }
 *   "textarea"    多行文本框          { "type": "textarea", "default": "说明文字" }
 *   "select"      下拉框              { "default": "medium", "options": ["small","medium","large"] }
 *   "checkbox"    复选框（开关）      { "default": true }
 *   "range"       滑块（右侧显示数值） { "type": "range", "default": 20, "min": 0, "max": 60, "step": 5 }
 *
 * ----------------------------------------------------------------------------
 * 二、不写 type 时的自动推断规则（依据 default 的取值类型）
 * ----------------------------------------------------------------------------
 *   default 是数组    -> "select"   下拉框（数组第一个元素作为默认选中值）
 *   default 是布尔    -> "checkbox" 复选框
 *   default 是数字    -> "range"    滑块
 *   default 是字符串  -> "text"     单行输入框
 *
 *   注意：数字默认渲染成"滑块"。想要数字输入框，必须显式写 "type": "number"。
 *   注意：想要多行文本框，必须显式写 "type": "textarea"。
 *
 * ----------------------------------------------------------------------------
 * 三、下拉框 options 写法（两种任选）
 * ----------------------------------------------------------------------------
 *   1) 简单值（显示文字与取值相同）：
 *        "options": ["small", "medium", "large"]
 *
 *   2) 取值与显示文字不同（default 要写 value 那一侧的值）：
 *        "options": [
 *          { "value": "png", "label": "PNG 图片" },
 *          { "value": "jpg", "label": "JPG 图片" }
 *        ]
 *
 *   也可以用 default 数组代替 options（等价于简单值写法）：
 *        "card_size": { "default": ["small", "medium", "large"] }
 *
 * ----------------------------------------------------------------------------
 * 四、简写：字段值直接给默认值（等价于 { "default": ... }）
 * ----------------------------------------------------------------------------
 *   "col_num": 3                等价于   { "default": 3 }
 *   "card_style": "default"     等价于   { "default": "default" }
 *
 * ----------------------------------------------------------------------------
 * 五、在代码里读取用户当前设置值
 * ----------------------------------------------------------------------------
 *   打开过设置面板后，可在控制台或脚本中调用：
 *     const values = window.getSettingsValues();
 *     // -> { col_num: 3, card_size: "medium", card_style: "default", ... }
 *   number / range 会转成数字，checkbox 转成布尔值，其余为字符串。
 * ==========================================================================*/

{
  "tabs": {
    "param": {
      /* 滑块：default 是数字时自动推断为 range；
              max 不写则取 default*2（且至少为 10） */
      "col_num": {
        "ch_Name": "列数",
        "default": 3,
        "min": 1,
        "max": 8,
        "step": 1
      },

      /* 下拉框：default 为数组 -> 自动推断为 select，
              数组第一个元素为默认选中项 */
      "card_size": {
        "ch_Name": "卡片大小",
        "default": ["medium", "small", "large"]
      },

      /* 输入框：default 为字符串 -> 自动推断为 text */
      "card_style": {
        "ch_Name": "卡片样式",
        "default": "default",
        "placeholder": "如：default / dark / mini"
      }

      /* ======================================================================
       * 以下是各类控件的示例，启用方法：
       *   删掉该示例上方的那一行 (开启示例) 与下方的那一行 (结束示例) 注释即可，
       *   示例内部已带好开头的逗号，直接可用。
       * ====================================================================== */

      /* ------------------------- (开启示例) 数字输入框 -------------------------
      ,"page_size": {
        "ch_Name": "每页数量",
        "type": "number",
        "default": 12,
        "min": 1,
        "max": 100,
        "step": 1,
        "placeholder": "1 ~ 100"
      }
      --------------------------- (结束示例) 数字输入框 ------------------------- */

      /* --------------------------- (开启示例) 滑块 ---------------------------
      ,"item_gap": {
        "ch_Name": "卡片间距",
        "type": "range",
        "default": 20,
        "min": 0,
        "max": 60,
        "step": 5
      }
      ----------------------------- (结束示例) 滑块 --------------------------- */

      /* -------------------------- (开启示例) 复选框 --------------------------
      ,"show_price": {
        "ch_Name": "显示价格",
        "default": true
      }
      ---------------------------- (结束示例) 复选框 -------------------------- */

      /* ------------------------- (开启示例) 多行文本框 -------------------------
      ,"remark": {
        "ch_Name": "备注",
        "type": "textarea",
        "default": "说明文字",
        "placeholder": "请输入备注"
      }
      --------------------------- (结束示例) 多行文本框 ------------------------- */

      /* ------------------- (开启示例) 下拉框：取值与显示文字不同 -------------------
      ,"export_format": {
        "ch_Name": "导出格式",
        "type": "select",
        "default": "png",
        "options": [
          { "value": "png", "label": "PNG 图片" },
          { "value": "jpg", "label": "JPG 图片" },
          { "value": "webp", "label": "WebP 图片" }
        ]
      }
      --------------------- (结束示例) 下拉框：取值与显示文字不同 ------------------- */

      /* ======================================================================
       * 新增一个 Tab 的写法：在下面的 "param" 同级再加一个 key，例如：
       *
       *   ,"about": {
       *     "version": { "ch_Name": "版本", "default": "1.0.0" },
       *     "author":  { "ch_Name": "作者", "default": "未填写" }
       *   }
       * ====================================================================== */
    }
  }
}
